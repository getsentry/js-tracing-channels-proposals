      "proposed": "Proposal drafted in this repo, not yet upstream",
      "not-started": "Tracked, no work yet",
      "no-go": "Not viable (unmaintained / superseded)",
      "skipped": "Intentionally skipped (covered elsewhere)",
      "none": "Not applicable / not pursued for this channel type"
    },
    "tiers": {
      "AAA": "Ships a TracingChannel (start/end/asyncStart/asyncEnd + context): the gold standard",
